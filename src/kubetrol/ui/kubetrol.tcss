Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

#workspace-top { height: 6; padding: 0 1; background: $background; }
#scope-bar { width: 40%; min-width: 24; height: 6; }
#scope-bar Static { height: 1; text-overflow: ellipsis; }
#build-info { color: $text-muted; }
#app-header { width: 1fr; height: 6; }
#view-actions { width: 1fr; height: 6; color: $text-muted; text-overflow: ellipsis; }
#brand { width: 22; height: 5; color: $accent; text-style: bold; }
.header-logo-compact #brand { width: 10; height: 3; text-align: right; }
.header-compact #scope-bar { width: 1fr; height: 4; }
.header-compact #app-header { width: 1fr; height: 4; }
.header-compact #view-actions { height: 4; }
.header-compact #cluster, .header-compact #user { display: none; }
.header-short #scope-bar { width: 1fr; height: 3; }
.header-short #cluster, .header-short #user, .header-short #build-info { display: none; }

#resources, #namespaces, #contexts, #standard-resources { height: auto; min-height: 2; max-height: 100%; background: $background; }
#resources.populated, #namespaces.populated, #contexts.populated, #standard-resources.populated { height: 1fr; }
#all-namespaces { height: 1; width: 1fr; border: none; background: $background; color: $accent; }

#empty-state { height: 1fr; align: center middle; padding: 0 1; }
#empty-title, #empty-description, #empty-hint { height: auto; text-align: center; }
#empty-title { text-style: bold; color: $text; }
#empty-description, #empty-hint { margin-top: 1; color: $text-muted; }
.input-bar { height: 1; margin: 0; background: $panel; }
.short WorkspaceBars { height: 2; }
#command-bar { height: 3; border: solid $primary; }
.short #command-bar { height: 1; border-top: none; border-bottom: none; }
#log-search-bar { height: 3; border: solid $primary; }
.short #log-search-bar { height: 1; border-top: none; border-bottom: none; }
.input-label { width: 2; height: 1; color: $accent; text-style: bold; }
Input { width: 1fr; height: 1; border: none; padding: 0; background: $panel; }
Input:focus { border: none; background: $primary 15%; }
CommandInput > .input--suggestion { color: $text-muted; text-style: italic; }
#status, #breadcrumbs { height: 1; margin: 0 1; text-overflow: ellipsis; }
#status { color: $text-muted; }
#breadcrumbs { color: $accent; }
.short #empty-state { display: none; }
.short #log-title, .short #log-targets { display: none; }
.short #log-hints { visibility: hidden; }

.-theme-k9s DataTable > .datatable--header { background: #000000; color: #ffffff; text-style: bold; }
.-theme-k9s DataTable > .datatable--cursor { background: #5fd7ff; color: #000000; text-style: none; }
.-theme-k9s DataTable > .datatable--even-row, .-theme-k9s DataTable > .datatable--odd-row { background: #000000; }
.-theme-k9s LogBody { background: #000000; color: #5fd7ff; }

HelpScreen {
    align: center middle;
    background: $background 70%;
}

#help-dialog {
    width: 90%;
    max-width: 72;
    height: 80%;
    max-height: 24;
    min-height: 6;
    border: round $primary;
    background: $panel;
    padding: 0 1;
}

#help-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

#help-scroll {
    height: 1fr;
    min-height: 1;
}

#help-content {
    height: auto;
}

#close-help {
    width: 1fr;
    height: 1;
    margin-top: 1;
}
